        "settingsVersion": {
          "const": 1
        },
        "values": {
          "type": "object",
          "properties": {
            "colorSpace": {
              "enum": [
                "srgb",
                "linear"
              ]
            },
            "alphaMode": {
              "enum": [
                "straight",
                "premultiplied"
              ]
            },
            "filter": {
              "enum": [
                "nearest",
                "linear"
              ]
            },
            "wrap": {
              "enum": [
                "clamp",
                "repeat",
                "mirror"
              ]
            },
            "mipmaps": {
              "type": "boolean"
            },
            "maxDimension": {
              "anyOf": [
                {
                  "enum": [
                    256,
                    512,
                    1024,
                    2048,
                    4096,
                    8192,
                    16384
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "compression": {
              "enum": [
                "lossless",
                "target_profile"
              ]
            },
