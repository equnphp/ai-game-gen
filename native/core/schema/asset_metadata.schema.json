          ],
          "additionalProperties": false
        }
      },
      "required": [
        "settingsKind",
        "settingsVersion",
        "values"
      ],
      "additionalProperties": false
    },
    "skeleton_import": {
      "type": "object",
      "properties": {
        "settingsKind": {
          "const": "skeleton.import"
        },
        "settingsVersion": {
          "const": 1
        },
        "values": {
          "type": "object",
          "properties": {
            "sourceFormat": {
              "enum": [
                "gamegen-skeleton-json",
                "spine-json",
                "dragonbones-json",
                "gltf2"
              ]
            },
            "sourceVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "unitScale": {
              "type": "number",
              "minimum": 0.000001,
              "maximum": 100000
            },
            "sourceYAxis": {
              "enum": [
                "up",
                "down"
              ]
            },
            "sourceRotationUnit": {
              "enum": [
                "degree",
                "radian"
              ]
            },
            "selectedAnimations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "maxItems": 1024
            },
            "selectedSkins": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "maxItems": 1024
            },
            "includeEvents": {
              "type": "boolean"
            },
            "includeAttachments": {
              "type": "boolean"
            },
            "boneNameMap": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "targetName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "sourceName",
                  "targetName"
                ],
                "additionalProperties": false
              },
              "maxItems": 4096
            },
            "animationNameMap": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "targetName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "sourceName",
                  "targetName"
                ],
                "additionalProperties": false
              },
              "maxItems": 4096
            },
            "weightPolicy": {
              "enum": [
                "preserve",
                "normalize",
                "reject_nonunit"
              ]
            }
          },
          "required": [
            "sourceFormat",
            "sourceVersion",
            "unitScale",
            "sourceYAxis",
            "sourceRotationUnit",
            "selectedAnimations",
            "selectedSkins",
            "includeEvents",
            "includeAttachments",
            "boneNameMap",
            "animationNameMap",
            "weightPolicy"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "settingsKind",
        "settingsVersion",
        "values"
      ],
      "additionalProperties": false
    },
