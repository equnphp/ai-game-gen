    "font_import": {
      "type": "object",
      "properties": {
        "settingsKind": {
          "const": "font.import"
        },
        "settingsVersion": {
          "const": 1
        },
        "values": {
          "type": "object",
          "properties": {
            "faceIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "style": {
              "enum": [
                "normal",
                "italic",
                "oblique"
              ]
            },
            "rasterMode": {
              "enum": [
                "vector",
                "bitmap",
                "sdf"
              ]
            },
            "renderSizePx": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "sdfRangePx": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "oversample": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "hinting": {
              "enum": [
                "none",
                "light",
                "full"
              ]
            },
            "glyphSet": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "all",
                    "ranges",
                    "project_text"
                  ]
                },
                "ranges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1114111
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1114111
                      }
                    },
                    "required": [
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 256
                },
                "extraText": {
                  "type": "string",
                  "maxLength": 65536
                }
              },
              "required": [
                "mode",
                "ranges",
                "extraText"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "faceIndex",
            "weight",
            "style",
            "rasterMode",
            "renderSizePx",
            "sdfRangePx",
            "oversample",
            "hinting",
