            "spacingY": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "projection": {
              "enum": [
                "orthographic",
                "isometric"
              ]
            },
            "directionOrder": {
              "type": "array",
              "items": {
                "enum": [
                  "N",
                  "NE",
                  "E",
                  "SE",
                  "S",
                  "SW",
                  "W",
                  "NW"
                ]
              },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 8
