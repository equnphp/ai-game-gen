    "audio_import": {
      "type": "object",
      "properties": {
        "settingsKind": {
          "const": "audio.import"
        },
        "settingsVersion": {
          "const": 1
        },
        "values": {
          "type": "object",
          "properties": {
            "channels": {
              "enum": [
                "preserve",
                "mono",
                "stereo"
              ]
            },
            "sampleRateHz": {
              "anyOf": [
                {
                  "enum": [
                    8000,
                    11025,
                    16000,
                    22050,
                    24000,
                    32000,
                    44100,
                    48000,
                    88200,
                    96000,
                    192000
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "normalize": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "none",
                    "peak",
                    "lufs"
                  ]
                },
                "peakDb": {
                  "type": "number",
                  "minimum": -24,
                  "maximum": 0
                },
                "lufs": {
                  "type": "number",
                  "minimum": -36,
                  "maximum": -5
                }
              },
              "required": [
                "mode",
                "peakDb",
                "lufs"
              ],
              "additionalProperties": false
            },
            "codec": {
              "enum": [
                "preserve",
                "pcm16",
                "opus",
                "aac"
              ]
            },
            "quality": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "dither": {
              "type": "boolean"
            }
