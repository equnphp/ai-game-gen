# 随真实native构建生成声明；不从旧capabilities猜JSON协议，也不将声明写成运行验证。
if(NOT DEFINED CORE_FILE OR NOT DEFINED ARTIFACT_FILE OR NOT DEFINED SQLITE_FILE OR NOT DEFINED INPUT_FILE OR NOT DEFINED OUTPUT_FILE)
  message(FATAL_ERROR "Native bundle arguments missing")
endif()
include("${INPUT_FILE}")
set(GG_LIBRARIES "[]")
set(GG_INDEX 0)
foreach(GG_ID CORE ARTIFACT SQLITE)
  file(SHA256 "${${GG_ID}_FILE}" GG_HASH)
  file(SIZE "${${GG_ID}_FILE}" GG_BYTES)
  get_filename_component(GG_FILENAME "${${GG_ID}_FILE}" NAME)
  set(GG_DEPS "[\"SQLITE\"]")
  if(GG_ID STREQUAL SQLITE)
    set(GG_DEPS "[]")
  endif()
  string(JSON GG_LIBRARIES SET "${GG_LIBRARIES}" ${GG_INDEX}
    "{\"id\":\"${GG_ID}\",\"relativeFile\":\"${GG_FILENAME}\",\"sha256\":\"sha256:${GG_HASH}\",\"bytes\":\"${GG_BYTES}\",\"dependencies\":${GG_DEPS}}")
  if(GG_ID STREQUAL CORE)
    set(GG_CORE_HASH "${GG_HASH}")
  endif()
  math(EXPR GG_INDEX "${GG_INDEX}+1")
endforeach()
set(GG_MANIFEST "{\"manifestVersion\":\"gg-native-runtime-bundle-2\",\"buildId\":\"gg-native-${GG_SOURCE_HASH}\",\"platform\":\"${GG_NATIVE_PLATFORM}\",\"libraries\":${GG_LIBRARIES},\"sqlite\":{\"version\":\"3.54.1\",\"sourceId\":\"${GG_SQLITE_SOURCE_ID}\",\"compileOptionsHash\":\"sha256:${GG_SQLITE_CONFIG_HASH}\",\"providerTarget\":\"gg_sqlite\",\"providerInstancePolicy\":\"one_per_process_linker_namespace\",\"wasmLinked\":false},\"coreProtocolManifest\":{\"manifestVersion\":1,\"coreAbi\":\"1.0\",\"coreLibrarySha256\":\"sha256:${GG_CORE_HASH}\",\"sourceRevision\":\"source-tree-sha256:${GG_SOURCE_HASH}\",\"declarationKind\":\"build_declaration\",\"coreProtocols\":[\"1.0\",\"1.1\"],\"requestContracts\":[{\"protocolVersion\":\"1.0\",\"requestSchemaSha256\":\"sha256:${GG_REQUEST_1_0_HASH}\"},{\"protocolVersion\":\"1.1\",\"requestSchemaSha256\":\"sha256:${GG_REQUEST_1_1_HASH}\"}]}}")
file(WRITE "${OUTPUT_FILE}.partial" "${GG_MANIFEST}\n")
file(RENAME "${OUTPUT_FILE}.partial" "${OUTPUT_FILE}")
