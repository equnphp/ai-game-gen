# 同源运行库供原生、WASM使用；不在这里创建作者数据库或平台权限目标。
get_filename_component(GG_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(gg_engine STATIC "${GG_SOURCE_ROOT}/engine/math2d.cpp")
target_include_directories(gg_engine PUBLIC "${GG_SOURCE_ROOT}")
add_library(gg_values STATIC "${GG_SOURCE_ROOT}/core/schema/value.cpp" "${GG_SOURCE_ROOT}/core/schema/validator.cpp" "${GG_SOURCE_ROOT}/engine/catalog.cpp")
target_include_directories(gg_values PUBLIC "${GG_SOURCE_ROOT}" PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
target_link_libraries(gg_values PUBLIC gg_json gg_hash)
add_library(gg_runtime STATIC "${GG_SOURCE_ROOT}/engine/input.cpp" "${GG_SOURCE_ROOT}/engine/ir.cpp" "${GG_SOURCE_ROOT}/engine/vm.cpp" "${GG_SOURCE_ROOT}/engine/world.cpp" "${GG_SOURCE_ROOT}/engine/camera.cpp")
target_sources(gg_runtime PRIVATE "${GG_SOURCE_ROOT}/engine/runner.cpp")
target_include_directories(gg_runtime PUBLIC "${GG_SOURCE_ROOT}")
target_link_libraries(gg_runtime PUBLIC gg_values gg_engine)
if(NOT GG_RUNTIME_ONLY)
  add_library(gg_compiler STATIC "${GG_SOURCE_ROOT}/engine/graph.cpp" "${GG_SOURCE_ROOT}/engine/graph_compiler.cpp")
  target_include_directories(gg_compiler PUBLIC "${GG_SOURCE_ROOT}" PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
  target_link_libraries(gg_compiler PUBLIC gg_values gg_runtime)
endif()
