# 固定vendor路径，源码缺失时明确停止，不漂移到系统库。
set(GG_VENDOR "${CMAKE_CURRENT_LIST_DIR}/../third_party")
foreach(p sqlite/sqlite3.c json/nlohmann/json.hpp mbedtls/library/sha256.c)
  if(NOT EXISTS "${GG_VENDOR}/${p}")
    message(FATAL_ERROR "Missing pinned dependency: ${p}. See third_party/README.md")
  endif()
endforeach()
# SQLite采用major*1000000+minor*1000+patch编码；3.54.1须严格匹配3054001。
file(STRINGS "${GG_VENDOR}/sqlite/sqlite3.h" GG_SQL_VERSION REGEX "^#define SQLITE_VERSION_NUMBER +3054001$")
if(NOT GG_SQL_VERSION)
  message(FATAL_ERROR "SQLite 3.54.1 is required")
endif()
add_library(gg_sqlite STATIC "${GG_VENDOR}/sqlite/sqlite3.c")
target_include_directories(gg_sqlite PUBLIC "${GG_VENDOR}/sqlite")
target_compile_definitions(gg_sqlite PRIVATE SQLITE_THREADSAFE=1 SQLITE_OMIT_LOAD_EXTENSION SQLITE_DQS=0)
add_library(gg_json INTERFACE)
target_include_directories(gg_json INTERFACE "${GG_VENDOR}/json")
add_library(gg_hash STATIC "${GG_VENDOR}/mbedtls/library/sha256.c" "${GG_VENDOR}/mbedtls/library/platform_util.c")
# Windows平台适配来自同一Mbed TLS版本，保持哈希实现与CRT兼容层配套。
if(WIN32)
  target_sources(gg_hash PRIVATE "${GG_VENDOR}/mbedtls/library/platform.c")
endif()
target_include_directories(gg_hash PUBLIC "${GG_VENDOR}/mbedtls/include")
target_include_directories(gg_hash PRIVATE "${GG_VENDOR}/mbedtls/library")
target_include_directories(gg_hash PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
target_compile_definitions(gg_hash PUBLIC MBEDTLS_CONFIG_FILE="gg_mbedtls_config.h")
