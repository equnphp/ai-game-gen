{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamegen.local/contracts/runtime-host-resource-1",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "epoch": {
          "type": "string",
          "format": "uuid"
        },
        "runtimeId": {
          "type": "string",
          "format": "uuid"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "method": {
          "const": "resource.read"
        },
        "params": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid"
            },
            "resourceKind": {
              "enum": [
                "manifest",
                "block"
              ]
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "offset": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          },
          "required": [
            "artifactId",
            "resourceKind",
            "hash",
            "offset",
            "maxBytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "epoch",
        "runtimeId",
        "requestId",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "const": "1.0"
            },
            "epoch": {
              "type": "string",
              "format": "uuid"
            },
            "runtimeId": {
              "type": "string",
              "format": "uuid"
            },
            "requestId": {
              "type": "string",
              "format": "uuid"
            },
            "ok": {
              "const": true
            },
            "data": {
              "type": "object",
              "properties": {
                "offset": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "decodedBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                },
                "base64": {
                  "type": "string",
                  "maxLength": 1398104
                },
                "eof": {
                  "type": "boolean"
                }
              },
              "required": [
                "offset",
                "decodedBytes",
                "base64",
                "eof"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "protocolVersion",
            "epoch",
            "runtimeId",
            "requestId",
            "ok",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "const": "1.0"
            },
            "epoch": {
              "type": "string",
              "format": "uuid"
            },
            "runtimeId": {
              "type": "string",
              "format": "uuid"
            },
            "requestId": {
              "type": "string",
              "format": "uuid"
            },
            "ok": {
              "const": false
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "messageKey": {
                  "type": "string",
                  "minLength": 1
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "messageKey",
                "retryable"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "protocolVersion",
            "epoch",
            "runtimeId",
            "requestId",
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    }
  ]
}
