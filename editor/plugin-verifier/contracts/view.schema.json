{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamegen.invalid/contracts/plugin-s1/view.schema.json",
  "$ref": "#/$defs/view",
  "$defs": {
    "view": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "gg-plugin-view/1"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "schema",
        "title",
        "nodes"
      ],
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "kind",
            "id",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "group"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              },
              "minItems": 0,
              "maxItems": 32
            }
          },
          "required": [
            "kind",
            "id",
            "label",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "button"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "actionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            },
            "disabled": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "label",
            "actionId",
            "disabled"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "textField"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            },
            "disabled": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "label",
            "value",
            "disabled"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "checkbox"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "value": {
              "type": "boolean"
            },
            "disabled": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "label",
            "value",
            "disabled"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "select"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "value": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96,
                  "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 96,
                    "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "id",
                  "label"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 32
            },
            "disabled": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "label",
            "value",
            "options",
            "disabled"
          ],
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "viewRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "actionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "controlId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4096
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "controlId",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "viewRevision",
        "actionId",
        "values"
      ],
      "additionalProperties": false
    },
    "viewStatus": {
      "enum": [
        "loading",
        "ready",
        "empty",
        "permission_required",
        "disabled",
        "missing",
        "incompatible",
        "busy",
        "cancelling",
        "failed"
      ]
    }
  }
}
