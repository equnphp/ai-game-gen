{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamegen.local/contracts/compiler-component-port/1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "method": {
          "const": "compiler.component.read"
        },
        "params": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "ok": {
          "const": true
        },
        "data": {
          "type": "object",
          "properties": {
            "componentGeneration": {
              "type": "string",
              "format": "uuid"
            },
            "metadataSha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "nativeBundleSha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "artifactLibrarySha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "nativeBuildId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "platform": {
              "enum": [
                "windows-x64",
                "windows-arm64",
                "android-arm64-v8a",
                "android-x86_64",
                "linux-x64",
                "macos-arm64",
                "macos-x64"
              ]
            },
            "compilerBuild": {
              "type": "string",
              "pattern": "^gg-compiler-1-[0-9a-f]{64}$"
            },
            "compilerBuildInputsHash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "catalogHash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "runtimeProfiles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "runtimeProfileId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "runtimeProfileHash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "runtimeBuild": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "variant": {
                    "enum": [
                      "development",
                      "release"
                    ]
                  },
                  "runtimeAbi": {
                    "const": "1.1"
                  },
                  "runtimePortProtocol": {
                    "enum": [
                      "1.0",
                      "1.1",
                      "1.2"
                    ]
                  },
                  "bundleFormat": {
                    "enum": [
                      "gg-runtime-bundle-1",
                      "gg-runtime-bundle-1.1",
                      "gg-runtime-bundle-1.2",
                      "gg-runtime-bundle-1.3"
                    ]
                  },
                  "irVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                  },
                  "irRevision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "runtimePairSha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "runtimeJsSha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "runtimeWasmSha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "runtimeProfileId",
                  "runtimeProfileHash",
                  "runtimeBuild",
                  "variant",
                  "runtimeAbi",
                  "runtimePortProtocol",
                  "bundleFormat",
                  "irVersion",
                  "irRevision",
                  "runtimePairSha256",
                  "runtimeJsSha256",
                  "runtimeWasmSha256"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 16
            },
            "integrityState": {
              "const": "bound_to_installed_files"
            },
            "declarationKind": {
              "const": "build_declaration"
            }
          },
          "required": [
            "componentGeneration",
            "metadataSha256",
            "nativeBundleSha256",
            "artifactLibrarySha256",
            "nativeBuildId",
            "platform",
            "compilerBuild",
            "compilerBuildInputsHash",
            "catalogHash",
            "runtimeProfiles",
            "integrityState",
            "declarationKind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "INVALID_MESSAGE",
                "UNSUPPORTED_PROTOCOL",
                "UNSUPPORTED_METHOD",
                "COMPONENT_UNAVAILABLE",
                "COMPONENT_INTEGRITY_ERROR",
                "COMPONENT_CHANGED",
                "LIMIT_EXCEEDED",
                "TIMEOUT",
                "INTERNAL_ERROR"
              ]
            },
            "messageKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "messageKey",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
