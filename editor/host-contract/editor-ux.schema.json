{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gamegen.invalid/editor-ux/1.1/editor-ux.schema.json",
  "title": "EditorUXPort 1.1 planned architecture contract",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "U64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4])$",
      "maxLength": 20
    },
    "GuideId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,63}$"
    },
    "GuideVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "StepId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{1,31}$"
    },
    "HintId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{1,127}$"
    },
    "StepStatus": {
      "type": "string",
      "enum": [
        "not_started",
        "active",
        "completed",
        "acknowledged",
        "skipped",
        "blocked"
      ]
    },
    "GuideStatus": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "skipped",
        "ended",
        "completed"
      ]
    },
    "PersistenceState": {
      "type": "string",
      "enum": [
        "clean",
        "pending",
        "failed"
      ]
    },
    "ProfileAvailability": {
      "type": "string",
      "enum": [
        "new",
        "loaded",
        "read_only",
        "corrupt",
        "future_schema",
        "memory_only"
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "profileBytes": {
          "type": "integer",
          "const": 262144
        },
        "practiceJournalBytes": {
          "type": "integer",
          "const": 8388608
        },
        "pendingPracticeRuns": {
          "type": "integer",
          "const": 1
        },
        "practiceJournalRecords": {
          "type": "integer",
          "const": 128
        },
        "commandReceipts": {
          "type": "integer",
          "const": 128
        },
        "courseVersionRecords": {
          "type": "integer",
          "const": 32
        },
        "stepsPerCourse": {
          "type": "integer",
          "const": 64
        },
        "suppressedHints": {
          "type": "integer",
          "const": 512
        },
        "requestBytes": {
          "type": "integer",
          "const": 65536
        },
        "responseBytes": {
          "type": "integer",
          "const": 524288
        },
        "eventRing": {
          "type": "integer",
          "const": 256
        },
        "eventReadItems": {
          "type": "integer",
          "const": 100
        },
        "localeFileBytes": {
          "type": "integer",
          "const": 8192
        },
        "localeWriteJobs": {
          "type": "integer",
          "const": 1
        },
        "localePendingIntents": {
          "type": "integer",
          "const": 1
        },
        "localeSelectionChannels": {
          "type": "integer",
          "const": 32
        }
      },
      "required": [
        "profileBytes",
        "practiceJournalBytes",
        "pendingPracticeRuns",
        "practiceJournalRecords",
        "commandReceipts",
        "courseVersionRecords",
        "stepsPerCourse",
        "suppressedHints",
        "requestBytes",
        "responseBytes",
        "eventRing",
        "eventReadItems",
        "localeFileBytes",
        "localeWriteJobs",
        "localePendingIntents",
        "localeSelectionChannels"
      ],
      "additionalProperties": false
    },
    "StepRecord": {
      "type": "object",
      "properties": {
        "stepId": {
          "$ref": "#/$defs/StepId"
        },
        "status": {
          "$ref": "#/$defs/StepStatus"
        },
        "proofRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UUID"
          },
          "maxItems": 8
        },
        "lastIntentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stepId",
        "status",
        "proofRefs",
        "lastIntentId",
        "reasonCode"
      ],
      "additionalProperties": false
    },
    "Binding": {
      "type": "object",
      "properties": {
        "projectId": {
          "anyOf": [
            {
              "$ref": "#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "entityId": {
          "anyOf": [
            {
              "$ref": "#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "creationIntentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "projectId",
        "entityId",
        "creationIntentId"
      ],
      "additionalProperties": false
    },
    "CourseRecord": {
      "type": "object",
      "properties": {
        "guideId": {
          "$ref": "#/$defs/GuideId"
        },
        "guideVersion": {
          "$ref": "#/$defs/GuideVersion"
        },
        "guideRevision": {
          "$ref": "#/$defs/U64"
        },
        "status": {
          "$ref": "#/$defs/GuideStatus"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepRecord"
          },
          "maxItems": 64
        },
        "lastStepId": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepId"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        }
      },
      "required": [
        "guideId",
        "guideVersion",
        "guideRevision",
        "status",
        "steps",
        "lastStepId",
        "binding"
      ],
      "additionalProperties": false
    },
    "ActiveRun": {
      "type": "object",
      "properties": {
        "runId": {
          "$ref": "#/$defs/UUID"
        },
        "guideId": {
          "$ref": "#/$defs/GuideId"
        },
        "guideVersion": {
          "$ref": "#/$defs/GuideVersion"
        },
        "stepId": {
          "$ref": "#/$defs/StepId"
        },
        "workspaceId": {
          "$ref": "#/$defs/UUID"
        },
        "displayState": {
          "type": "string",
          "enum": [
            "running",
            "suspended"
          ]
        },
        "blockedReason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runId",
        "guideId",
        "guideVersion",
        "stepId",
        "workspaceId",
        "displayState",
        "blockedReason"
      ],
      "additionalProperties": false
    },
    "Preferences": {
      "type": "object",
      "properties": {
        "autoHints": {
          "type": "boolean"
        },
        "showLearningProgress": {
          "type": "boolean"
        },
        "suppressedHintIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HintId"
          },
          "maxItems": 512,
          "uniqueItems": true
        }
      },
      "required": [
        "autoHints",
        "showLearningProgress",
        "suppressedHintIds"
      ],
      "additionalProperties": false
    },
    "ProfileSnapshot": {
      "type": "object",
      "properties": {
        "serviceInstanceId": {
          "$ref": "#/$defs/UUID"
        },
        "profileSchemaVersion": {
          "const": 1
        },
        "profileRevision": {
          "$ref": "#/$defs/U64"
        },
        "persistedRevision": {
          "anyOf": [
            {
              "$ref": "#/$defs/U64"
            },
            {
              "type": "null"
            }
          ]
        },
        "persistenceState": {
          "$ref": "#/$defs/PersistenceState"
        },
        "availability": {
          "$ref": "#/$defs/ProfileAvailability"
        },
        "lastWriteError": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            {
              "type": "null"
            }
          ]
        },
        "welcomeHandled": {
          "type": "boolean"
        },
        "preferences": {
          "$ref": "#/$defs/Preferences"
        },
        "courses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CourseRecord"
          },
          "maxItems": 32
        },
        "activeRun": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActiveRun"
            },
            {
              "type": "null"
            }
          ]
        },
        "localeState": {
          "$ref": "#/$defs/LocaleSnapshot"
        }
      },
      "required": [
        "serviceInstanceId",
        "profileSchemaVersion",
        "profileRevision",
        "persistedRevision",
        "persistenceState",
        "availability",
        "lastWriteError",
        "welcomeHandled",
        "preferences",
        "courses",
        "activeRun",
        "localeState"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_MESSAGE",
            "UNSUPPORTED_PROTOCOL",
            "PERMISSION_DENIED",
            "SERVICE_RESTARTED",
            "PROFILE_CONFLICT",
            "GUIDE_CONFLICT",
            "GUIDE_RUN_INVALID",
            "GUIDE_STEP_INVALID",
            "GUIDE_NOT_FOUND",
            "PROFILE_WRITE_FAILED",
            "PROFILE_READ_ONLY",
            "PROFILE_LIMIT",
            "COURSE_UNAVAILABLE",
            "MISSING_CAPABILITY",
            "TARGET_UNAVAILABLE",
            "IDEMPOTENCY_CONFLICT",
            "STATE_NOT_READY",
            "INTERNAL_ERROR",
            "UNSUPPORTED_LOCALE",
            "LOCALE_CHANNEL_INVALID",
            "LOCALE_INTENT_STALE",
            "LOCALE_STORAGE_FAILED",
            "LOCALE_READ_ONLY",
            "LOCALE_RESULT_UNKNOWN",
            "LOCALE_REVISION_EXHAUSTED"
          ]
        },
        "messageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "retryable": {
          "type": "boolean"
        },
        "snapshot": {
          "$ref": "#/$defs/ProfileSnapshot"
        },
        "localeState": {
          "$ref": "#/$defs/LocaleSnapshot"
        }
      },
      "required": [
        "code",
        "messageKey",
        "retryable"
      ],
      "additionalProperties": false
    },
    "MutationReceipt": {
      "type": "object",
      "properties": {
        "commandId": {
          "$ref": "#/$defs/UUID"
        },
        "appliedInSession": {
          "const": true
        },
        "profile": {
          "$ref": "#/$defs/ProfileSnapshot"
        }
      },
      "required": [
        "commandId",
        "appliedInSession",
        "profile"
      ],
      "additionalProperties": false
    },
    "GuideAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "welcome.dismiss"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "start"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "resume"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "replay"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "select_step"
            },
            "runId": {
              "$ref": "#/$defs/UUID"
            },
            "stepId": {
              "$ref": "#/$defs/StepId"
            }
          },
          "required": [
            "kind",
            "runId",
            "stepId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "acknowledge"
            },
            "runId": {
              "$ref": "#/$defs/UUID"
            },
            "stepId": {
              "$ref": "#/$defs/StepId"
            }
          },
          "required": [
            "kind",
            "runId",
            "stepId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "skip_step"
            },
            "runId": {
              "$ref": "#/$defs/UUID"
            },
            "stepId": {
              "$ref": "#/$defs/StepId"
            }
          },
          "required": [
            "kind",
            "runId",
            "stepId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "end"
            },
            "runId": {
              "$ref": "#/$defs/UUID"
            }
          },
          "required": [
            "kind",
            "runId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Event": {
      "oneOf": [
        {
          "$ref": "#/$defs/GuideEvent"
        },
        {
          "$ref": "#/$defs/LocaleEvent"
        }
      ]
    },
    "Method": {
      "type": "string",
      "enum": [
        "ux.describe",
        "ux.snapshot",
        "ux.preferences.update",
        "ux.guide.intent",
        "ux.preferences.reset",
        "ux.events.read",
        "ux.locale.select"
      ]
    },
    "ux_describe_Params": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "ux_describe_Result": {
      "type": "object",
      "properties": {
        "uxProtocol": {
          "const": "1.1"
        },
        "serviceInstanceId": {
          "$ref": "#/$defs/UUID"
        },
        "adapterKind": {
          "type": "string",
          "enum": [
            "tauri-local",
            "browser-real-local",
            "mock"
          ]
        },
        "profileSchemaVersion": {
          "const": 1
        },
        "guideCatalogHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "availableGuides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "guideId": {
                "$ref": "#/$defs/GuideId"
              },
              "guideVersion": {
                "$ref": "#/$defs/GuideVersion"
              },
              "available": {
                "type": "boolean"
              },
              "missingCapabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96
                },
                "maxItems": 32
              }
            },
            "required": [
              "guideId",
              "guideVersion",
              "available",
              "missingCapabilities"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        },
        "implementedMethods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Method"
          },
          "maxItems": 7
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "supportedUxProtocols": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "1.0",
              "1.1"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "locale": {
          "type": "object",
          "properties": {
            "supportedLocales": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/$defs/Locale"
                  },
                  "nativeName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 48
                  }
                },
                "required": [
                  "id",
                  "nativeName"
                ],
                "additionalProperties": false
              },
              "maxItems": 7,
              "minItems": 7
            },
            "defaultLocale": {
              "const": "en"
            },
            "fallbackLocale": {
              "const": "en"
            },
            "localeSchemaVersion": {
              "const": 1
            },
            "selectionChannelId": {
              "$ref": "#/$defs/UUID"
            },
            "latestSelectionSeq": {
              "$ref": "#/$defs/U64"
            },
            "resourceCatalogVersion": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96
                },
                {
                  "type": "null"
                }
              ]
            },
            "resourceCatalogHash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "resourceLocales": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Locale"
              },
              "maxItems": 7,
              "uniqueItems": true
            }
          },
          "required": [
            "supportedLocales",
            "defaultLocale",
            "fallbackLocale",
            "localeSchemaVersion",
            "selectionChannelId",
            "latestSelectionSeq",
            "resourceCatalogVersion",
            "resourceCatalogHash",
            "resourceLocales"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "uxProtocol",
        "serviceInstanceId",
        "adapterKind",
        "profileSchemaVersion",
        "guideCatalogHash",
        "availableGuides",
        "implementedMethods",
        "limits",
        "supportedUxProtocols",
        "locale"
      ],
      "additionalProperties": false
    },
    "ux_snapshot_Params": {
      "type": "object",
      "properties": {
        "serviceInstanceId": {
          "$ref": "#/$defs/UUID"
        }
      },
      "required": [
        "serviceInstanceId"
      ],
      "additionalProperties": false
    },
    "ux_snapshot_Result": {
      "$ref": "#/$defs/ProfileSnapshot"
    },
    "ux_preferences_update_Params": {
      "type": "object",
      "properties": {
        "serviceInstanceId": {
          "$ref": "#/$defs/UUID"
        },
        "commandId": {
          "$ref": "#/$defs/UUID"
        },
        "expectedProfileRevision": {
          "$ref": "#/$defs/U64"
        },
        "changes": {
          "type": "object",
          "properties": {
            "autoHints": {
              "type": "boolean"
            },
            "showLearningProgress": {
              "type": "boolean"
            },
            "hintSuppression": {
              "type": "object",
              "properties": {
                "hintId": {
                  "$ref": "#/$defs/HintId"
                },
                "suppressed": {
                  "type": "boolean"
                }
              },
              "required": [
                "hintId",
                "suppressed"
              ],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "serviceInstanceId",
        "commandId",
        "expectedProfileRevision",
        "changes"
      ],
      "additionalProperties": false
    },
    "ux_preferences_update_Result": {
      "$ref": "#/$defs/MutationReceipt"
    },
    "ux_guide_intent_Params": {
      "type": "object",
      "properties": {
        "serviceInstanceId": {
          "$ref": "#/$defs/UUID"
        },
        "commandId": {
          "$ref": "#/$defs/UUID"
        },
        "guideId": {
          "$ref": "#/$defs/GuideId"
        },
        "guideVersion": {
          "$ref": "#/$defs/GuideVersion"
        },
        "expectedGuideRevision": {
          "$ref": "#/$defs/U64"
        },
        "action": {
          "$ref": "#/$defs/GuideAction"
        }
      },
      "required": [
        "serviceInstanceId",
        "commandId",
        "guideId",
        "guideVersion",
        "expectedGuideRevision",
        "action"
      ],
      "additionalProperties": false
    },
    "ux_guide_intent_Result": {
      "$ref": "#/$defs/MutationReceipt"
    },
    "ux_preferences_reset_Params": {
      "type": "object",
      "properties": {
        "serviceInstanceId": {
          "$ref": "#/$defs/UUID"
        },
        "commandId": {
          "$ref": "#/$defs/UUID"
        },
        "expectedProfileRevision": {
          "$ref": "#/$defs/U64"
        },
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "one-course"
                },
                "guideId": {
                  "$ref": "#/$defs/GuideId"
                },
                "guideVersion": {
                  "$ref": "#/$defs/GuideVersion"
                }
              },
              "required": [
                "kind",
                "guideId",
                "guideVersion"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "all-guide-records"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "resetHintPreferences": {
          "type": "boolean"
        }
      },
      "required": [
        "serviceInstanceId",
        "commandId",
        "expectedProfileRevision",
        "scope",
        "resetHintPreferences"
      ],
      "additionalProperties": false
    },
    "ux_preferences_reset_Result": {
      "$ref": "#/$defs/MutationReceipt"
    },
    "ux_events_read_Params": {
