        "coreRequestId",
        "originCallId"
      ],
      "additionalProperties": false
    },
    "SessionInfo": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/SessionState"
        },
        "sessionId": {
          "$ref": "#/$defs/UUID"
        },
        "coreInstanceId": {
          "$ref": "#/$defs/UUID"
        },
        "projectState": {
          "type": "string",
          "enum": [
            "NONE",
            "OPEN",
            "UNKNOWN"
          ]
        },
        "activeTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "resultSlotTask": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaskTicket"
          },
          "maxItems": 32
        }
      },
      "required": [
        "state",
        "sessionId",
        "coreInstanceId",
        "projectState",
        "activeTasks",
        "resultSlotTask",
        "tasks"
      ],
      "additionalProperties": false
    },
    "CoreEvent": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "#/$defs/U64"
