        "CLOSING",
        "FAILED"
      ]
    },
    "Cursor": {
      "type": "object",
      "properties": {
        "hostInstanceId": {
          "$ref": "#/$defs/UUID"
        },
        "sessionId": {
          "$ref": "#/$defs/UUID"
        },
        "coreInstanceId": {
          "$ref": "#/$defs/UUID"
        },
        "afterSeq": {
          "$ref": "#/$defs/U64"
        }
      },
      "required": [
        "hostInstanceId",
        "sessionId",
        "coreInstanceId",
        "afterSeq"
      ],
      "additionalProperties": false
    },
    "Limits": {
      "type": "object",
      "properties": {
        "requestJsonBytes": {
          "type": "integer",
          "const": 2097152
        },
        "binaryChunkBytes": {
          "type": "integer",
          "const": 1048576
        },
        "resultDecodedBytes": {
          "type": "integer",
          "const": 8388608
        },
        "coreTaskSlots": {
          "type": "integer",
          "const": 32
        },
        "hostPendingCalls": {
          "type": "integer",
          "const": 16
        },
        "coreEventRing": {
          "type": "integer",
          "const": 256
        },
        "eventPollItems": {
          "type": "integer",
          "const": 100
        },
        "eventDecodedBytes": {
          "type": "integer",
          "const": 1048576
        },
        "resultCacheSlots": {
          "type": "integer",
          "const": 1
        },
        "resultCacheDecodedBytes": {
          "type": "integer",
          "const": 8388608
        },
        "wireLineBytes": {
          "type": "integer",
          "const": 16777216
        },
        "uploadPendingChunks": {
          "type": "integer",
          "const": 4
        },
        "driverMaxRequestIds": {
          "type": "integer",
          "const": 65536
        },
        "driverNewWorkThreshold": {
          "type": "integer",
          "const": 65000
        }
      },
      "required": [
        "requestJsonBytes",
        "binaryChunkBytes",
        "resultDecodedBytes",
        "coreTaskSlots",
        "hostPendingCalls",
        "coreEventRing",
        "eventPollItems",
        "eventDecodedBytes",
        "resultCacheSlots",
        "resultCacheDecodedBytes",
        "wireLineBytes",
        "uploadPendingChunks",
        "driverMaxRequestIds",
        "driverNewWorkThreshold"
      ],
      "additionalProperties": false
    },
    "HostError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_MESSAGE",
            "UNSUPPORTED_PROTOCOL",
            "UNSUPPORTED",
            "VERSION_MISMATCH",
            "PERMISSION_DENIED",
            "SESSION_LIMIT",
            "SESSION_INVALID",
            "SESSION_CLOSING",
            "TASK_INVALID",
            "NOT_READY",
            "BUSY",
            "LIMIT_EXCEEDED",
            "QUEUE_FULL",
            "CORE_ABI",
            "CORE_CONTRACT_VIOLATION",
            "TRANSPORT_LOST",
            "TIMEOUT",
            "LIBRARY_NOT_FOUND",
            "LIBRARY_INVALID",
            "SHUTTING_DOWN",
            "INTERNAL_ERROR",
            "PROTOCOL_ERROR",
            "CURSOR_INVALID"
          ]
        },
        "messageKey": {
          "type": "string",
          "maxLength": 160,
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "not_submitted",
            "submitted_unknown",
            "not_applicable"
          ]
        },
        "coreStatus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "coreErrorJson": {
          "$ref": "#/$defs/Json2"
        },
        "affectedCoreRequestId": {
          "$ref": "#/$defs/UUID"
        },
        "sessionState": {
          "$ref": "#/$defs/SessionState"
        }
      },
      "required": [
        "code",
        "messageKey",
        "retryable",
        "outcome"
      ],
      "additionalProperties": false
    },
    "TaskTicket": {
      "type": "object",
      "properties": {
        "taskRef": {
          "$ref": "#/$defs/TaskRef"
        },
        "coreRequestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "originCallId": {
          "$ref": "#/$defs/UUID"
        }
      },
      "required": [
