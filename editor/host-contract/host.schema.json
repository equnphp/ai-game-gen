{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gamegen.invalid/editor-host/1.0/host.schema.json",
  "title": "EditorHostPort 1.0 exact wire contract, architecture declaration only",
  "oneOf": [
    {
      "$ref": "#/$defs/HostRequest"
    },
    {
      "$ref": "#/$defs/HostResponse"
    }
  ],
  "$defs": {
    "UUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "U64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4])$",
      "maxLength": 20
    },
    "SessionToken": {
      "type": "string",
      "pattern": "^s1\\.[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "TaskRef": {
      "type": "string",
      "pattern": "^t1\\.[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "GrantRef": {
      "type": "string",
      "pattern": "^g1\\.[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Json2": {
      "type": "object",
      "properties": {
        "decodedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "base64": {
          "type": "string",
          "maxLength": 2796204,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "decodedBytes",
        "base64"
      ],
      "additionalProperties": false,
      "x-semantic-rules": [
        "strict RFC4648 canonical standard base64; decoded length equals decodedBytes and <=2097152",
        "UTF8 JSON variants additionally require valid UTF8/no BOM/no duplicate keys/depth <=32; this annotation is not executable schema validation"
      ]
    },
    "Json8": {
      "type": "object",
      "properties": {
        "decodedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "base64": {
          "type": "string",
          "maxLength": 11184812,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "decodedBytes",
        "base64"
      ],
      "additionalProperties": false,
      "x-semantic-rules": [
        "strict RFC4648 canonical standard base64; decoded length equals decodedBytes and <=8388608",
        "UTF8 JSON variants additionally require valid UTF8/no BOM/no duplicate keys/depth <=32; this annotation is not executable schema validation"
      ]
    },
    "EventJson": {
      "type": "object",
      "properties": {
        "decodedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "base64": {
          "type": "string",
          "maxLength": 1398104,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "decodedBytes",
        "base64"
      ],
      "additionalProperties": false,
      "x-semantic-rules": [
        "strict RFC4648 canonical standard base64; decoded length equals decodedBytes and <=1048576",
        "UTF8 JSON variants additionally require valid UTF8/no BOM/no duplicate keys/depth <=32; this annotation is not executable schema validation"
      ]
    },
    "BinaryChunk": {
      "type": "object",
      "properties": {
        "decodedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "base64": {
          "type": "string",
          "maxLength": 1398104,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "decodedBytes",
        "base64"
      ],
      "additionalProperties": false,
      "x-semantic-rules": [
        "strict RFC4648 canonical standard base64; decoded length equals decodedBytes and <=1048576",
        "UTF8 JSON variants additionally require valid UTF8/no BOM/no duplicate keys/depth <=32; this annotation is not executable schema validation"
      ]
    },
    "InputChunk": {
      "type": "object",
      "properties": {
        "decodedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "base64": {
          "type": "string",
          "maxLength": 1398104,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "decodedBytes",
        "base64"
      ],
      "additionalProperties": false,
      "x-semantic-rules": [
        "strict RFC4648 canonical standard base64; decoded length equals decodedBytes and <=1048576",
        "UTF8 JSON variants additionally require valid UTF8/no BOM/no duplicate keys/depth <=32; this annotation is not executable schema validation"
      ]
    },
    "Capability": {
      "type": "string",
      "enum": [
        "core.project_store",
        "core.scene_documents",
        "core.asset_stream",
        "core.events",
        "editor.graph",
        "preview.control"
      ]
    },
    "AdapterKind": {
      "type": "string",
      "enum": [
        "tauri-native",
        "browser-real-core",
        "mock"
      ]
    },
    "TaskState": {
      "type": "string",
