              "const": "1.0"
            },
            {
              "type": "null"
            }
          ]
        },
        "implementedMethods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HostMethod"
          },
          "maxItems": 12
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        }
      },
      "required": [
        "contractVersion",
        "hostInstanceId",
        "adapterKind",
        "hostBuildId",
        "coreBuildId",
        "coreAbi",
        "implementedMethods",
        "limits"
      ],
      "additionalProperties": false
