        "jsonUtf8": {
          "$ref": "#/$defs/EventJson"
        }
      },
      "required": [
        "seq",
        "jsonUtf8"
      ],
      "additionalProperties": false
    },
    "HostMethod": {
      "type": "string",
      "enum": [
        "host.describe",
        "session.open",
        "session.state",
        "session.close",
        "core.submit",
        "upload.write",
        "blob.read",
        "task.status",
        "task.result",
        "task.cancel",
        "task.release",
        "events.read"
