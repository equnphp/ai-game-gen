{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameGen",
  "version": "0.1.0",
  "identifier": "com.aimeta.gamegen.editor",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GameGen",
        "width": 1440,
        "height": 960,
        "minWidth": 390,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "resources/": "."
    }
  }
}
