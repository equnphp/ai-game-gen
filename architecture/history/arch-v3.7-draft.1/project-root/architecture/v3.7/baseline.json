        "decision": "完整F01—F21、24玩法家族和既有专业功能保留；增量不等于删范围"
      },
      {
        "id": "ADR-09",
        "status": "license_text_pending",
        "decision": "GPL方向；独立生成游戏允许闭源商用；GPL-3.0-only+运行/导出例外和接口MIT为方案建议，非已生效许可；私有服务独立且不得复制GPL实现"
      },
      {
        "id": "ADR-10",
        "status": "user_scope_confirmed_design_unverified",
        "decision": "H5、WebView/WASM APK、微信小游戏、抖音小游戏四运行目标；Cocos仅参考，不集成其源码/运行时/SDK/官方适配器/模板/构建服务"
      },
      {
        "id": "ADR-11",
        "status": "user_scope_confirmed_design_proposed",
        "decision": "共享C++创作领域+应用服务+Runtime+资源+Interchange+Sync+Policy；稳定C ABI和薄绑定；不同平台分别编译"
      },
      {
        "id": "ADR-12",
        "status": "proposed",
        "decision": "Flutter移动表现层+Kotlin/Swift系统薄桥，保留Qt开源桌面候选；替代路线和视口/输入/许可风险待评审"
      },
      {
        "id": "ADR-13",
        "status": "current_requirement_design_proposed",
        "decision": "当前Windows只接受Cocos Creator/LayaAir/Godot源工程，Reader独立实现/分代Profile，纯数据解析→MigrationIR→GameGen原生文档/工作流；重导入三方比较"
      },
      {
        "id": "ADR-14",
        "status": "current_requirement_design_proposed",
        "decision": "Windows/Android仅LAN发现/配对/双向同步；各端完整副本、快照/CAS分块账本/领域三方合并/原子提交；无云中继/ADB/公网回落"
      },
      {
        "id": "ADR-15",
        "status": "current_requirement_design_proposed",
        "decision": "localOnly标签传播到派生内容和统一出站策略；凭据不传输；不自动向模型/MCP/日志/遥测/备份上传"
      },
      {
        "id": "ADR-16",
        "status": "future_scope_confirmed_contract_now",
        "decision": "未来三类原生可编辑工程Writer独立于四GamePackage出口，从完整创作Snapshot产生SEM；具体版本/覆盖未来冻结，当前无无损往返承诺"
      },
      {
        "id": "ADR-17",
        "status": "future_scope_confirmed_ports_now",
        "decision": "iOS/iPad/Android平板为未来创作编辑器，游戏保持四目标；EditorHost/GameRuntime/ProjectFormat三Profile独立；未来Apple本机Agent/后台/构建/分发许可未验证"
      },
      {
        "id": "COST-01",
        "status": "user_constraint",
        "decision": "必需软件组件不得依赖强制商业授权费、版税或付费构建服务；冻结版本核查免费许可路径；可选云/模型/平台分发成本另列，不默认采购"
      }
    ],
