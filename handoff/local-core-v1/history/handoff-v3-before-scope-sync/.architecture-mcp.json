  },
  "data": {
    "ownership": "STORE单写者；文档/资产/历史/快照同SQLite权威；UI/AI未来不得直写",
    "classification": "全部默认localOnly；资产来源/许可与内容hash独立；凭据不入库/日志",
    "consistency": "BEGIN IMMEDIATE CAS revision→版本/引用/资源/快照/请求→COMMIT→事件，具体见transactions.md",
    "migration": "v1新建0→1，未知旧版/较新不强写；未来注册迁移备份/副本验证/保留原件",
    "backup_restore": "SQLite backup API；快照恢复为新事务；GC保护20自动+128锁定+200历史及活跃上传",
    "retention": "20未锁自动点，最多128锁定点，200可撤销窗口；提交摘要不因过期允许重放"
  },
  "decisions": [
    {
      "id": "ADR-LC-01",
      "owner": "architecture",
      "context": "一期外部CAS+DB双存储提交/恢复复杂，需明确原子边界",
      "selected": "sqlite_blob_store",
      "options": [
        {
          "name": "sqlite_blob_store",
          "benefits": "文档/资源/幂等/快照同原子边界，跨端一致",
          "costs": "库体积/备份/GC成本，首期容量有界",
          "risks": "性能待测，后续大资产需迁移后端"
        },
        {
          "name": "external_cas_now",
          "benefits": "大资产独立文件访问",
          "costs": "持久化/跨存储提交/恢复/备份复杂",
          "risks": "半资源引用/目录落盘语义不清"
        }
      ],
      "reason": "以原子性与有界一期交付为优先，保留内容寻址接口",
      "consequences": "明确变更旧外部资产建议；后续触发容量时另设计原子迁移",
      "reversal": "保留旧库只读，BlobStore迁移不改领域ID，禁止直接换路径后沿用验证结论"
    },
    {
      "id": "ADR-LC-02",
      "owner": "architecture",
      "context": "多平台FFI回调/释放有调度竞态",
      "selected": "pull_tasks",
      "options": [
        {
          "name": "pull_tasks",
          "benefits": "无跨语言业务回调，所有权简单",
          "costs": "宿主轮询与结果租约维护",
          "risks": "未消费结果导致背压，必须明示"
        },
        {
          "name": "business_callbacks",
          "benefits": "通知及时",
          "costs": "线程调度/反入/析构复杂",
          "risks": "回调跨UI生命周期悬空"
        }
      ],
      "reason": "本地有界任务+poll/事件环减少竞态",
      "consequences": "结果池8MiB、任务32、事件256，失游标重读",
      "reversal": "后续可加只唤醒通知，不改变业务所有权"
    }
  ],
