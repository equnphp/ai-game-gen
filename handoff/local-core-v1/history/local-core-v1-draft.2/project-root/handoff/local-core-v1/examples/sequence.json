{
  "version": "local-core-v1-draft.2",
  "note": "设计示例，未执行；capture与$变量是驱动替换规则，不是原始SDK消息中的特殊语法。",
  "identity": {
    "projectId": "22222222-2222-4222-8222-222222222222",
    "settingsId": "33333333-3333-4333-8333-333333333333",
    "sceneId": "44444444-4444-4444-8444-444444444444"
  },
  "steps": [
    {
      "request": {
        "protocolVersion": "1.0",
        "requestId": "10000000-0000-4000-8000-000000000001",
        "op": "project.create",
        "params": {
          "directory": "sample.ggproject",
          "name": "本地示例",
          "projectId": "22222222-2222-4222-8222-222222222222",
          "settingsId": "33333333-3333-4333-8333-333333333333",
          "defaultSceneId": "44444444-4444-4444-8444-444444444444"
        }
      },
      "expect": {
        "headRevision": "0"
      }
    },
    {
      "request": {
        "protocolVersion": "1.0",
        "requestId": "10000000-0000-4000-8000-000000000002",
        "op": "document.propose",
        "projectId": "22222222-2222-4222-8222-222222222222",
        "expectedRevision": "0",
        "params": {
          "operations": [
            {
              "kind": "set_field",
              "documentId": "44444444-4444-4444-8444-444444444444",
              "path": "/name",
              "value": "第一关"
            }
          ]
        }
      },
      "capture": [
        "proposalId",
        "proposalHash"
      ]
    },
    {
      "request_template": {
        "protocolVersion": "1.0",
        "requestId": "10000000-0000-4000-8000-000000000003",
        "op": "document.validate",
        "projectId": "22222222-2222-4222-8222-222222222222",
        "params": {
          "proposalId": "$proposalId",
          "proposalHash": "$proposalHash"
        }
      },
      "capture": [
        "validatedHash"
      ]
    },
    {
      "request_template": {
        "protocolVersion": "1.0",
        "requestId": "10000000-0000-4000-8000-000000000004",
        "op": "document.commit",
        "projectId": "22222222-2222-4222-8222-222222222222",
        "expectedRevision": "0",
        "params": {
          "proposalId": "$proposalId",
          "validatedHash": "$validatedHash"
        }
      },
      "expect": {
        "revision": "1",
        "durable": true
      },
      "retry_rule": "同一完整JSON字节重发不新增revision；不同字节同requestId拒绝"
    },
    {
      "request": {
        "protocolVersion": "1.0",
        "requestId": "10000000-0000-4000-8000-000000000005",
        "op": "history.undo",
        "projectId": "22222222-2222-4222-8222-222222222222",
        "expectedRevision": "1",
        "params": {}
      },
      "expect": {
        "revision": "2"
      }
    },
    {
      "request": {
        "protocolVersion": "1.0",
        "requestId": "10000000-0000-4000-8000-000000000006",
        "op": "history.redo",
        "projectId": "22222222-2222-4222-8222-222222222222",
        "expectedRevision": "2",
        "params": {}
      },
      "expect": {
        "revision": "3"
      }
    },
    {
      "action": "flush/close/release task+buffers/destroy，再新Core open并document.read",
      "expect": "Scene名称为第一关，headRevision=3；任务/事件实例是新的，领域ID不变"
    }
  ]
}
